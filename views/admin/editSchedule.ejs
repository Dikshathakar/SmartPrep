<!DOCTYPE html>
<html>
<head>
  <title>Upload Students</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/css/adminHeader.css">
    <style>
  form {
    max-width: 700px;
    margin: auto;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: #fafafa;
  }
  label {
    display: block;
    margin-top: 10px;
    font-weight: 600;
  }
  input {
    width: 100%;
    padding: 6px;
    margin-top: 4px;
  }
  .test-block {
    background: #f0f0f0;
    padding: 12px;
    margin-top: 15px;
    border-radius: 6px;
  }
  button {
    margin-top: 15px;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
  }
</style>
  </head>
  
  <body class="bg-light">
  <nav class="navbar navbar-default">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/adminDashboard" id="logo">
                    <span><img src="/images/exam.png" height="38px" width="35px"></span> SmartPrep
                </a>
            </div>
            <div class="collapse navbar-collapse" id="myNavbar">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/admin/adminDashboard">Dashboard</a></li>
                    <li><a href="/admin/logout" class="text-danger">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>
    


<form action="/admin/schedule/<%= schedule._id %>?_method=PUT" method="POST">
  <!-- CSRF token -->
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <!-- Exam Date -->
  <label for="examDate">Exam Date:</label>
  <input type="date" 
         name="examDate" 
         value="<%= schedule.examDate instanceof Date ? schedule.examDate.toISOString().split('T')[0] : schedule.examDate %>" 
         required>

  <hr>

  <!-- Loop through tests -->
  <% schedule.tests.forEach((test, index) => { %>
    <div class="test-block">
      <h3>Test <%= index + 1 %></h3>

      <label for="tests[<%= index %>][testNo]">Test No:</label>
      <input type="text" 
             name="tests[<%= index %>][testNo]" 
             value="<%= test.testNo %>" 
             required>

      <label for="tests[<%= index %>][type]">Type:</label>
      <input type="text" 
             name="tests[<%= index %>][type]" 
             value="<%= test.type %>" 
             required>

      <label for="tests[<%= index %>][subtype]">Subtype:</label>
      <input type="text" 
             name="tests[<%= index %>][subtype]" 
             value="<%= test.subtype %>" 
             required>

      <label for="tests[<%= index %>][marks]">Marks:</label>
      <input type="number" 
             name="tests[<%= index %>][marks]" 
             value="<%= test.marks %>" 
             required>

      <label for="tests[<%= index %>][startTime]">Start Time:</label>
      <input type="time" 
             name="tests[<%= index %>][startTime]" 
             value="<%= test.startTime instanceof Date ? test.startTime.toISOString().substring(11,16) : test.startTime %>" 
             required>

      <label for="tests[<%= index %>][endTime]">End Time:</label>
      <input type="time" 
             name="tests[<%= index %>][endTime]" 
             value="<%= test.endTime instanceof Date ? test.endTime.toISOString().substring(11,16) : test.endTime %>" 
             required>

      <hr>
    </div>
  <% }) %>

  <button type="submit" class="btn btn-primary">Update Schedule</button>
</form>

</body>
</html>


