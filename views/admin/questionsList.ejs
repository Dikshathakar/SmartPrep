<!DOCTYPE html>
<html>
<head>
    <title>Questions List</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/css/adminHeader.css">
    <link rel="stylesheet" href="/css/questionList.css">
</head>
    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const success = urlParams.get('success');
        const error = urlParams.get('error');

        if (success) {
            alert(decodeURIComponent(success));
        }

        if (error) {
            alert(decodeURIComponent(error));
        }

        // Clean the URL to remove query parameters after showing alerts
        if (success || error) {
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });
</script>

<body>
<nav class="navbar navbar-default">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/adminDashboard" id="logo">
                    <span><img src="/images/exam.png" height="38px" width="35px"></span> SmartPrep
                </a>
            </div>
            <div class="collapse navbar-collapse" id="myNavbar">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/admin/adminDashboard">Dashboard</a></li>
                    <li><a href="/admin/logout" class="text-danger">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>

        <h1>Questions List</h1>

<div class="container">

    <form method="GET" action="/admin/questions" class="form-inline text-center" style="margin-bottom: 20px;">
    <div class="form-group">
        <label for="category">Filter by Category:</label>
        <select name="category" id="category" class="form-control" style="margin-left: 10px;">
            <option value="">All</option>
            <option value="programming" <%= selectedCategory === 'programming' ? 'selected' : '' %>>Programming</option>
            <option value="aptitude" <%= selectedCategory === 'aptitude' ? 'selected' : '' %>>Aptitude</option>
            <option value="technical" <%= selectedCategory === 'technical' ? 'selected' : '' %>>Technical</option>
        </select>
    </div>
    <button type="submit" class="btn btn-primary" style="margin-left: 10px;">Search</button>
</form>



    <table class="table table-bordered">
        <thead>
            <tr class="bg-primary">
                <th>Company</th>
                <th>Category</th>
                <th>Subcategory</th>
                <th>Type</th>
                <th>Question</th>
                <th>Answer</th> <!-- Added this column -->
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% questions.forEach(q => { %>
                <tr>
                    <td><%= q.company %></td>
                    <td><%= q.category %></td>
                    <td><%= q.subcategory || '-' %></td>
                    <td><%= q.type %></td>
                    <td><%= q.question %></td>
                    <td><%= q.answer %></td> <!-- Display answer here -->
                    <td>
                        <a href="/admin/questions/edit/<%= q._id %>" class="btn btn-sm btn-warning">Edit</a><br>
                        <form action="/admin/questions/delete/<%= q._id %>" method="POST" style="display:inline;">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><br>        
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

</body>
</html>

<script>
    document.getElementById("category").addEventListener("change", function () {
        this.form.submit();
    });
</script>

