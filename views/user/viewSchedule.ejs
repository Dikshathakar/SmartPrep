<!DOCTYPE html>
<html>
<head>
    <title>Available Tests</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/css/header.css">

    <style>
      h2{
          color: #333;
      }
    .schedule-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 20px;
      background: #fff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    .schedule-table th {
      background: #31475f;
      color: white;
      text-align: center;
      padding: 10px;
      
    }
    .schedule-table td {
      text-align: center;
      padding: 8px;
      border: 1px solid #ddd;
      vertical-align: middle;
    }
    .schedule-table tr:nth-child(even) { background: #f9f9f9; }
    .schedule-table tr:hover { background: #f1f1f1; }
  </style>
    
</head>
<body>

  
    <!-- Navbar -->
    <nav class="navbar navbar-default">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>                        
                </button>
                <a class="navbar-brand" href="/user" id="logo">
                    <span><img src="/images/exam.png" height="38px" width="35px"></span> SmartPrep
                </a>
            </div>
            <div class="collapse navbar-collapse" id="myNavbar">
                <ul class="nav navbar-nav navbar-right">
                    
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/auth/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>


<div class="container">
  <h2 class="text-center">Test Schedule</h2>

  <table class="schedule-table table table-bordered">
    <thead>
      <tr>
        <th>Date</th>
        <th>Test No</th>
        <th>Type</th>
        <th>Subtype</th>
        <th>Marks</th>
        <th>Start</th>
        <th>End</th>
      </tr>
    </thead>
    <tbody>
      <% schedules.forEach(schedule => { %>
        <% schedule.tests.forEach((test, index) => { %>
          <tr>
            <% if (index === 0) { %>
              <td rowspan="<%= schedule.tests.length %>">
                <%= schedule.examDate ? schedule.examDate.toDateString() : "N/A" %>
              </td>
            <% } %>

            <td><%= index + 1 %></td>
            <td><%= test.type || "N/A" %></td>
            <td><%= test.subtype || "N/A" %></td>
            <td><%= test.marks || "N/A" %></td>
            <td><%= test.startTime || "N/A" %></td>
            <td><%= test.endTime || "N/A" %></td>
          </tr>
        <% }) %>
      <% }) %>
    </tbody>
  </table>
</div>

</body>
</html>
