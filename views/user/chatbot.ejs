<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Interview Chatbot</title>
  <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
  <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>    
  <link rel="stylesheet" href="/css/header.css">
  <link rel="stylesheet" href="/css/chatbot.css">
</head>
<body>

<nav class="navbar navbar-default">
  <div class="container-fluid">
      <div class="navbar-header">
          <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
              <span class="icon-bar"></span>
          </button>
          <a class="navbar-brand" href="/user" id="logo">
              <span><img src="/images/exam.png" height="38px" width="35px"></span> SmartPrep
          </a>
      </div>
      <div class="collapse navbar-collapse" id="myNavbar">
          <ul class="nav navbar-nav navbar-right">
              <li><a href="/dashboard">Dashboard</a></li>
              <li><a href="/user/chatbot">Chatbot</a></li>
              <li><a href="/user/instructions">Test</a></li>
              <li><a href="/user/contactus">Contact</a></li>
              <li><a href="/user/profile">Profile</a></li>
              <li><a href="/auth/logout">Logout</a></li>
          </ul>
      </div>
  </div>
</nav>

<div class="container">
  
  
  <div class="row">

    <!-- History area -->
    <div class="col-md-4">

      <div style="margin-bottom: 10px;">
        <button id="new-chat-btn" class="btn btn-lg">
          <span class="glyphicon glyphicon-edit"></span> New Chat
        </button>
      </div>

      <h4>Your Search History</h4>
      <ul id="history" class="list-unstyled">
        <% 
          const today = new Date();
          history.forEach(item => { 
            const createdDate = new Date(item.createdAt);
            function isSameDay(d1, d2) {
              return d1.getDate() === d2.getDate() &&
                     d1.getMonth() === d2.getMonth() &&
                     d1.getFullYear() === d2.getFullYear();
            }
            let dateLabel;
            if (isSameDay(createdDate, today)) {
              dateLabel = 'Today';
            } else {
              dateLabel = createdDate.toLocaleDateString('en-US', { 
                year: 'numeric', month: 'short', day: 'numeric' 
              });
            }
        %>
        <li class="history-item" data-query-id="<%= item._id %>" data-query="<%= item.query %>">
          <div class="history-text">
            <strong><%= item.query %></strong>
            <small style="color: gray;"> - <%= dateLabel %></small>
          </div>
          <span class="delete-btn">
            <img src="/images/delete.png" height="24px" width="20px">
          </span>
        </li>

        <% }) %>
      </ul>
    </div>
    
    <!-- Chat area -->
    <div class="col-md-8">
      <h3>Looking for recently asked interview questions? I'm here to help!</h3>
      <div id="chat-box" class="box">
        <input id="input" placeholder="Interview questions for..." autocomplete="off"/>
        <button id="send">Send</button>
        <ul id="messages"></ul>
      </div>
    </div>

  </div>
  
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const input = document.getElementById('input');
  const send = document.getElementById('send');
  const messages = document.getElementById('messages');
  const historyList = document.getElementById('history');

  function sendMessage() {
    const msg = input.value.trim();
    if (msg) {
      socket.emit('user-message', msg);
      addMessage('You: ' + msg, false, 'user');
      input.value = '';
    }
  }

  send.addEventListener('click', sendMessage);
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      sendMessage();
    }
  });

  socket.on('bot-message', (msg) => {
  if (msg.text) {
    addMessage(msg.text.replace(/\n/g, '<br>'), true, 'bot');
  } else if (msg.items && Array.isArray(msg.items)) {
    const formatted = msg.items.map(item =>
      `<strong>Q:</strong> ${item.question}<br><strong>A:</strong> ${item.answer}`
    ).join('<br><br>');
    addMessage(formatted, true, 'bot');
  } else {
    addMessage("🤖 Sorry, I didn't understand that.", true, 'bot');
  }
});


  function addMessage(content, isHtml = false, sender = 'bot') {
    const li = document.createElement('li');
    li.classList.add('message', sender);
    if (isHtml) {
      li.innerHTML = content;
    } else {
      li.textContent = content;
    }
    messages.appendChild(li);
    messages.scrollTop = messages.scrollHeight;
  }

  // Handle click on history items (re-run search)
  function setupHistoryItem(li) {
    li.querySelector('.delete-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      const queryId = li.getAttribute('data-query-id');
      socket.emit('delete-history', queryId);
    });

    li.addEventListener('click', () => {
      const query = li.getAttribute('data-query');
      input.value = query;
      sendMessage();
    });
  }

  // Setup initial history items
  document.querySelectorAll('.history-item').forEach(setupHistoryItem);

  // Update history when new item comes
  socket.on('update-history', (item) => {
    const li = document.createElement('li');
    li.classList.add('history-item');
    li.setAttribute('data-query-id', item._id);
    li.setAttribute('data-query', item.query);
    li.innerHTML = `<strong>${item.query}</strong> <small style="color: gray;"> - Today</small> <span class="delete-btn">&times;</span>`;
    setupHistoryItem(li);
    historyList.insertBefore(li, historyList.firstChild);
  });

  // Remove history item on delete
  socket.on('history-deleted', (queryId) => {
    const li = document.querySelector(`.history-item[data-query-id="${queryId}"]`);
    if (li) {
      li.remove();
    }
  });


  // Show error message if needed
  socket.on('error', (msg) => {
    alert(msg);
  });

  document.getElementById("new-chat-btn").addEventListener("click", () => {
  // ✅ Clear messages from UI
  document.getElementById("messages").innerHTML = "";

  // ✅ Optionally clear input box
  document.getElementById("input").value = "";

  // ✅ Clear chat history (only frontend)
  // If you also want to clear history from DB, emit a socket event to delete history
  socket.emit("clear-chat");

  // ✅ You can also reload page to reset everything
  // location.reload(); // Uncomment this if you want a full reset
});

</script>

</body>
</html>
