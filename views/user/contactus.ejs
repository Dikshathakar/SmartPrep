<!DOCTYPE html>
<html lang="en">
<head>
    <title>Contact Us</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/contactus.css">
</head>
<body>
    <nav class="navbar navbar-default">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="/user" id="logo">
                    <span><img src="/images/exam.png" height="38px" width="35px"></span> SmartPrep
                </a>
            </div>
            <div class="collapse navbar-collapse" id="myNavbar">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="/dashboard">Dashboard</a></li>
                    <li><a href="/user/chatbot">chatbot</a></li>
                    <li><a href="/user/instructions">Test</a></li>
                    <li><a href="/user/contactus">Contact</a></li>
                    <li><a href="/user/profile">Profile</a></li>
                    <li><a href="/auth/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="contact-container">
        <div class="contact-left">
            <h2>Chat With Us!!</h2>
            <p>If you have any questions regarding the tests, schedules, or anything else, feel free to reach out using the contact form.</p>
        </div>
        <div class="contact-right">
            <h3>Contact</h3>
            <form action="/contactus" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <input type="text" name="name" class="form-control" placeholder="Name" value="<%= user?.name || '' %>"  required><br>
                <input type="email" name="email" class="form-control" placeholder="Email" value="<%= user?.email || '' %>" required><br>
                <input type="tel" name="phone" class="form-control" placeholder="Phone"><br>
                <textarea name="message" class="form-control" placeholder="Message" rows="3" required></textarea><br>
    
                <button type="submit" class="btn btn-custom">Submit</button>
            </form>

        </div>
    </div>
</body>
</html>
